# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Secret key (service role): solo server-side, nunca exponer al browser.
SUPABASE_SECRET_KEY=your-secret-key

# WhatsApp Cloud API (Meta) — solo server-side, usado desde
# services/whatsappNotificationService.ts. Ver docs de WhatsApp Business Platform:
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_CLOUD_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_TEMPLATE_PATIENT_CONFIRMATION=appointment_confirmation_patient
WHATSAPP_TEMPLATE_PROFESSIONAL_CONFIRMATION=appointment_confirmation_professional
WHATSAPP_TEMPLATE_LANGUAGE_CODE=es_AR
