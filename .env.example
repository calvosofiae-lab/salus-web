# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Secret key (service role): solo server-side, nunca exponer al browser.
SUPABASE_SECRET_KEY=your-secret-key

# Email transaccional (Resend) — solo server-side, usado desde
# services/emailNotificationService.ts. RESEND_FROM_EMAIL requiere un dominio propio
# verificado en Resend (no se puede usar una dirección de Gmail/Yahoo/etc. como remitente).
# https://resend.com/docs
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="SALUS <no-reply@tu-dominio.com>"
